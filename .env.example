# Copy this file to .env and adjust it if needed.
# .env is git-ignored, so real credentials never end up in the repository.

# Application under test
BASE_URL=https://rahulshettyacademy.com/client/

# Optional: a permanent account, so the login test can run on its own
# without the registration test creating a new user first.
EXISTING_USER_EMAIL=
EXISTING_USER_PASSWORD=
